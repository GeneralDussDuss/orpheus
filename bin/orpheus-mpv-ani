#!/bin/sh
# A player that does not play.
#
# ani-cli only knows how to launch a player, so the cheapest way to get a
# stream URL out of it is to BE one. The name matters: ani-cli matches its
# player against `*mpv*` and hands that branch the referrer, the subtitle file
# and the title, which is exactly the part a resolver would otherwise have to
# reimplement. A hianime URL without its referrer is a 403.
#
#   ORPHEUS_ANI_RESOLVE=<file>   write the arguments as JSON, play nothing
#   unset                        pass them to the real mpv, in an Orpheus window
#
# The second mode is for tools that must own the player themselves (Curd needs
# the IPC socket for AniList sync and intro skipping), so they still land in a
# window Hyprland places like every other Orpheus video.
set -u

referrer=""; subs=""; title=""; url=""
for a in "$@"; do
  case "$a" in
    --referrer=*)           referrer=${a#*=} ;;
    --sub-file=*|--sub-files=*) subs=${a#*=} ;;
    --force-media-title=*)  title=${a#*=} ;;
    -*)                     ;;
    *)                      url=$a ;;
  esac
done

if [ -z "${ORPHEUS_ANI_RESOLVE:-}" ]; then
  exec mpv "$@" --force-window=yes --title="Orpheus ╱╱ \${media-title}"
fi

esc() { printf '%s' "$1" | sed 's|\\|\\\\|g; s|"|\\"|g'; }
printf '{"url":"%s","referrer":"%s","subs":"%s","title":"%s"}\n' \
  "$(esc "$url")" "$(esc "$referrer")" "$(esc "$subs")" "$(esc "$title")" \
  >"$ORPHEUS_ANI_RESOLVE"
